# Firebase — optional. Leave this file uncopied and the app runs in
# local-only mode (data lives in the browser, nothing is sent anywhere).
#
# These values are NOT secrets: Firebase publishes them in the client bundle
# by design. They identify the project; they authorise nothing. Access is
# enforced by firestore.rules, which scopes every document to its owner's uid.
#
# To enable cloud sync:
#   1. Create a project at https://console.firebase.google.com
#   2. Add a Web app, copy its config values below into a .env.local
#   3. Build > Firestore Database > create (production mode)
#   4. Build > Authentication > enable "Anonymous" and "Google"
#   5. Deploy the rules:  npx firebase-tools deploy --only firestore:rules
#   6. Add the same values as GitHub repo variables so deploys pick them up

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to 1 only when running against the local emulators
# VITE_FIREBASE_EMULATOR=1
