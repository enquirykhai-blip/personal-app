# Loaded by `npm run dev:cloud` (vite --mode emulator). Points the app at the
# local Firebase emulators, so no real project is needed to work on sync.
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-myspace.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-myspace
VITE_FIREBASE_APP_ID=1:0:web:demo
VITE_FIREBASE_EMULATOR=1
